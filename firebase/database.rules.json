{
  "rules": {
    "esp32": {
      ".read": true,
      ".write": true
    },
    "pc": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "uidLinks": {
      "$firebaseUid": {
        ".read": "auth != null && auth.uid === $firebaseUid",
        ".write": "auth != null && auth.uid === $firebaseUid && (!data.exists() || data.val() === newData.val())",
        ".validate": "newData.isString()"
      }
    },
    "usernames": {
      "$lowercaseName": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() === root.child('uidLinks').child(auth.uid).val() && (!data.exists() || data.val() === newData.val())",
        ".validate": "newData.isString()"
      }
    },
    "users": {
      "$mcUuid": {
        "presence": {
          ".read": "auth != null && (root.child('uidLinks').child(auth.uid).val() === $mcUuid || root.child('users').child($mcUuid).child('friends').child(root.child('uidLinks').child(auth.uid).val()).val() === 'accepted')",
          ".write": "auth != null && root.child('uidLinks').child(auth.uid).val() === $mcUuid"
        },
        "profile": {
          ".read": "auth != null && (root.child('uidLinks').child(auth.uid).val() === $mcUuid || root.child('users').child($mcUuid).child('friends').child(root.child('uidLinks').child(auth.uid).val()).exists())",
          ".write": "auth != null && root.child('uidLinks').child(auth.uid).val() === $mcUuid"
        },
        "friends": {
          ".read": "auth != null && root.child('uidLinks').child(auth.uid).val() === $mcUuid",
          "$otherUuid": {
            ".read": "auth != null && (root.child('uidLinks').child(auth.uid).val() === $mcUuid || root.child('uidLinks').child(auth.uid).val() === $otherUuid)",
            ".write": "auth != null && (root.child('uidLinks').child(auth.uid).val() === $mcUuid || root.child('uidLinks').child(auth.uid).val() === $otherUuid)"
          }
        }
      }
    }
  }
}
